{
  "apiVersion": 1,
  "id": "xiaohongshu-interests",
  "name": "小红书兴趣发现",
  "version": "1.0.0",
  "entry": "index.cjs",
  "description": "推荐流与兴趣关键词互补，读取笔记原文后由 AI 筛选，加入统一推送。",
  "capabilities": ["xiaohongshu.read", "ai.tools"],
  "fields": [
    {
      "key": "accountId",
      "label": "登录账号 ID",
      "type": "text",
      "required": true
    },
    {
      "key": "interests",
      "label": "兴趣与筛选要求",
      "type": "textarea",
      "required": true
    },
    {
      "key": "maxItems",
      "label": "每轮最多推送篇数（1–3）",
      "type": "number",
      "default": 3
    },
    {
      "key": "includeImages",
      "label": "附上原帖配图",
      "type": "boolean",
      "default": true
    },
    {
      "key": "useFeed",
      "label": "读取小红书推荐流",
      "type": "boolean",
      "default": true
    },
    {
      "key": "useSearch",
      "label": "按兴趣补充关键词检索",
      "type": "boolean",
      "default": true
    }
  ]
}
